{
  "name": "flame-project",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace flame-frontend",
    "dev:backend": "npm run dev --workspace flame-backend",
    "server": "npm run start --workspace flame-backend",
    "start": "npm run start --workspace flame-backend",
    "build": "npm run build --workspace flame-frontend",
    "build:android": "node scripts/build-android.mjs",
    "android:apk": "node scripts/build-android.mjs --apk",
    "restore:mongo": "node scripts/restore-local-data-to-mongo.mjs",
    "preview": "npm run preview --workspace flame-frontend"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4"
  }
}
