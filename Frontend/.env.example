# Vercel full-stack deployment: REST/auth/feed/discover use its same-origin serverless API.
VITE_API_URL=/api
# Optional realtime server for Socket.IO when hosted on a persistent Render service.
VITE_SOCKET_URL=https://your-render-service.onrender.com
# Set to false while the persistent Socket.IO service is unavailable; REST fallbacks remain active.
VITE_REALTIME_ENABLED=false
