MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=flame
MONGODB_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=0
FLAME_AUTO_INDEX=true
# Set to mongo in production. Set to local only for local JSON development.
FLAME_DATASTORE=
# Comma-separated frontend origins allowed to use the REST API and Socket.IO service.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://flamedating.vercel.app
FRONTEND_URL=https://flamedating.vercel.app
# Render provides this automatically; set it only for equivalent hosted environments.
RENDER_EXTERNAL_URL=https://your-render-service.onrender.com
# Inline chat media is persisted in MongoDB state; keep this bounded until object storage is configured.
MESSAGE_INLINE_MEDIA_MAX_CHARS=1500000
POSITIONSTACK_API_KEY=your_positionstack_api_key_here
YOUTUBE_API_KEY=your_youtube_data_api_key_here
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
